# Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase (Connect > Session pooler) or local PostgreSQL
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=your-database-password
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
# "require" for Supabase, "prefer" for local Postgres
DB_SSLMODE=require

# Optional: limit registration to one school email domain, e.g. school.edu.ph. Leave blank for any email.
RETRACK_EMAIL_DOMAIN=
